generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  PROFESSIONAL
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  planTier         String   @default("MULTI_USER")
  maxUsers         Int      @default(1)
  ownerEmail       String
  status           String   @default("ACTIVE")
  
  whatsappSession  String?  
  timezone         String   @default("America/Sao_Paulo")
  billingConfig    Json?
  bookingRules     Json?
  remindersConfig  Json?
  
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  users            User[]
  services         Service[]
  products         Product[]
  professionals    Professional[]
  customers        Customer[]
  appointments     Appointment[]
  waitlist         Waitlist[]
  blocks           ScheduleBlock[]
  aiConfig         AiConfig?
}

model User {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name                 String
  email                String
  passwordHash         String
  role                 Role      @default(PROFESSIONAL)
  active               Boolean   @default(true)
  
  isEmailVerified      Boolean   @default(false)
  verificationCode     String?
  verificationToken    String?   @unique
  verificationExpires  DateTime?
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  professional         Professional?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Professional {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  name                  String
  phone                 String?
  servicesHandled       String[] 
  workSchedule          Json?    
  maxAppointmentsPerDay Int?
  
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  appointments          Appointment[]
  blocks                ScheduleBlock[]

  @@index([tenantId])
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  bufferTimeMins  Int      @default(0)
  active          Boolean  @default(true)

  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  appointments    Appointment[]

  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  active      Boolean  @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@index([tenantId])
}

model Customer {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  phone              String
  name               String?
  preferredProfId    String?
  preferredServiceId String?
  visitCount         Int      @default(0)
  lastVisitDate      DateTime? @db.Date

  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  appointments       Appointment[]
  waitlist           Waitlist[]

  @@unique([tenantId, phone])
}

model Appointment {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  customerName   String
  customerPhone  String
  
  startTime      DateTime          @db.Timestamptz
  endTime        DateTime          @db.Timestamptz
  status         AppointmentStatus @default(PENDING)
  
  pixQrCode      String?
  reminder24h    Boolean           @default(false)
  reminder1h     Boolean           @default(false)

  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  @@index([tenantId, professionalId, startTime])
  @@index([tenantId, startTime])
}

model ScheduleBlock {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  date           DateTime     @db.Date
  startTime      String?      
  endTime        String?      
  reason         String?

  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@index([tenantId, professionalId, date])
}

model Waitlist {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  customerName   String
  customerPhone  String
  professionalId String?
  serviceId      String?
  
  preferredDate  DateTime     @db.Date
  
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@index([tenantId, preferredDate])
}

model AiConfig {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  systemPrompt   String   @db.Text
  businessInfo   String   @db.Text
  faqItems       Json?    
  voiceId        String?
  voiceReplyMode String   @default("NEVER") 
}
